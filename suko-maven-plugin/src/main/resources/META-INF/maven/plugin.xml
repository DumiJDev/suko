<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>Suko Maven Plugin</name>
  <description>Maven plugin for compiling Suko (.sk) files to JTE (.jte) templates.</description>
  <groupId>io.suko</groupId>
  <artifactId>suko-maven-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <goalPrefix>suko</goalPrefix>
  <isolatedRealm>false</isolatedRealm>
  <inheritedByDefault>true</inheritedByDefault>
  <mojos>
    <mojo>
      <goal>compile</goal>
      <description>Compiles .sk (Suko) files under sourceDir to .jte templates under outputDir.</description>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <requiresReports>false</requiresReports>
      <aggregator>false</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <phase>generate-sources</phase>
      <implementation>io.suko.lang.maven.SukoCompileMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-lookup</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>project</name>
          <type>org.apache.maven.project.MavenProject</type>
          <required>true</required>
          <editable>false</editable>
          <description>The Maven project.</description>
        </parameter>
        <parameter>
          <name>sourceDir</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>Directory containing .sk source files.</description>
        </parameter>
        <parameter>
          <name>outputDir</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>Output directory for generated .jte files.</description>
        </parameter>
        <parameter>
          <name>generatedPackage</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>Package name for generated classes.</description>
        </parameter>
      </parameters>
      <configuration>
        <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
        <sourceDir implementation="java.io.File" default-value="${project.basedir}/src/main/suko">${suko.sourceDir}</sourceDir>
        <outputDir implementation="java.io.File" default-value="${project.build.directory}/generated-sources/suko">${suko.outputDir}</outputDir>
        <generatedPackage implementation="java.lang.String" default-value="io.suko.generated">${suko.package}</generatedPackage>
      </configuration>
    </mojo>
  </mojos>
</plugin>
