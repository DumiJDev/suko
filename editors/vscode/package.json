{
  "name": "suko-vscode",
  "displayName": "Suko",
  "description": "Suporte da linguagem Suko: destaque de sintaxe, diagnósticos em tempo real, go-to-definition, hover e completion.",
  "version": "0.1.0",
  "publisher": "suko",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DumiJDev/suko.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "suko",
    "jte",
    "templates",
    "java"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "suko",
        "aliases": [
          "Suko",
          "suko"
        ],
        "extensions": [
          ".sk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "suko",
        "scopeName": "source.suko",
        "path": "./syntaxes/suko.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.suko": "java"
        }
      }
    ],
    "configuration": {
      "title": "Suko",
      "properties": {
        "suko.java.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "Pasta de um JDK/JRE **21 ou superior** usado para correr o language server. Se vazio, usa `JAVA_HOME` e depois o `java` do `PATH`.",
          "scope": "machine"
        },
        "suko.sourceRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "Pasta dos ficheiros `.sk`, relativa à pasta do workspace. Só é usada quando não há `suko.json` com `sourceRoot` nem a pasta `src/main/suko`."
        },
        "suko.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Regista a comunicação entre o VS Code e o language server no canal \"Suko Language Server (trace)\"."
        }
      }
    },
    "commands": [
      {
        "command": "suko.restartServer",
        "title": "Suko: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-server": "node scripts/copy-server.mjs",
    "test:unit": "npm run compile && node --test \"out/test/unit/*.test.js\"",
    "test:grammar": "vscode-tmgrammar-snap -g syntaxes/suko.tmLanguage.json \"test/grammar/*.sk\"",
    "test:electron": "npm run compile && npm run bundle && node out/test/electron/runTest.js",
    "test": "npm run copy-server && npm run test:unit && npm run test:server && npm run test:grammar",
    "package": "npm run copy-server && npm run compile && npm run bundle && vsce package --no-dependencies",
    "test:grammar:update": "vscode-tmgrammar-snap -g syntaxes/suko.tmLanguage.json --updateSnapshot \"test/grammar/*.sk\"",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.js",
    "test:server": "npm run compile && node --test \"out/test/integration/*.test.js\""
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3",
    "vscode-tmgrammar-test": "^0.1.3",
    "esbuild": "^0.28.2",
    "vscode-languageserver-protocol": "3.18.4"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Num workspace não confiável o language server não arranca: a extensão executaria o Java indicado pelas settings do workspace.",
      "restrictedConfigurations": [
        "suko.java.home",
        "suko.sourceRoot"
      ]
    }
  }
}
