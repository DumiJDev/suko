package shop.lab;

import shop.Layout;

// Perfil lab: com target que abre outro contexto o rel leva sempre noopener (SukoSafe.rel);
// o ping passa pela SukoSafe.ping. Nenhum rel literal usa 'opener'.
public component LabRelPage(String title, int cartCount, List<Map<String, String>> categories, String rel, String t, String p, List<Map<String, String>> items) {
  Layout(title = title, cartCount = cartCount, categories = categories) {
    <h1>Lab de rel e ping</h1>
    <form class="lab-input" method="get" action="/lab/rel">
      <label>rel
        <input type="text" name="rel" value=${rel} maxlength="500" />
      </label>
      <label>target
        <input type="text" name="t" value=${t} maxlength="500" />
      </label>
      <label>ping
        <input type="text" name="p" value=${p} maxlength="500" />
      </label>
      <button type="submit">Ver</button>
    </form>
    <p><a class="lab-rel" href="https://example.com/" target="_blank" rel=${rel}>target blank com rel dinâmico</a></p>
    <p><a class="lab-rel-target" href="https://example.com/" target=${t} rel=${rel}>target e rel dinâmicos</a></p>
    <p><a class="lab-target" href="https://example.com/" target=${t}>target dinâmico sem rel</a></p>
    <p><a class="lab-ping" href="/lab/rel" ping=${p}>link com ping dinâmico</a></p>
    <h2>Valores guardados</h2>
    <ul class="lab-items">
      for (Map<String, String> i : items) {
        <li>
          <a class="lab-item-rel" href="https://example.com/" target="_blank" rel=${i.get("value")}>rel guardado</a>
          <a class="lab-item-ping" href="/lab/rel" ping=${i.get("value")}>ping guardado</a>
        </li>
      }
    </ul>
  }
}
