package shop;

import shop.Layout;

public component ProductPage(String title, int cartCount, List<Map<String, String>> categories, Map<String, String> product, List<Map<String, String>> reviews) {
  Layout(title = title, cartCount = cartCount, categories = categories) {
    <article class="product">
      <img src=${product.get("imageUrl")} alt=${product.get("name")} width="320" height="200" />
      <div>
        <h1>${product.get("name")}</h1>
        <p class="price">${product.get("price")}</p>
        <p class="description">${product.get("description")}</p>
        <p class="stock">Em stock: ${product.get("stock")}</p>
        <p><a href="/c/${product.get("categorySlug")}">Ver mais produtos desta categoria</a></p>
      </div>
    </article>
    <section class="reviews-section">
      <h2>Avaliações</h2>
      if (reviews.isEmpty()) {
        <p class="empty">Ainda não há avaliações.</p>
      } else {
        <ul class="reviews">
          for (Map<String, String> r : reviews) {
            <li class="review">
              <strong class="author">${r.get("author")}</strong>
              <span class="rating">${r.get("rating")} em 5</span>
              <p class="body">${r.get("body")}</p>
              if (!r.get("website").isEmpty()) {
                <a class="website" href=${r.get("website")} rel="nofollow ugc">site do autor</a>
              }
            </li>
          }
        </ul>
      }
    </section>
  }
}
