package shop;

import shop.Layout;
import shop.ReviewList;
import shop.ReviewForm;

public component ProductPage(String title, int cartCount, List<Map<String, String>> categories, String csrfName, String csrfToken, Map<String, String> product, List<Map<String, String>> reviews, Map<String, String> form, Map<String, String> errors) {
  Layout(title = title, cartCount = cartCount, categories = categories) {
    <article class="product">
      <img src=${product.get("imageUrl")} alt=${product.get("name")} width="320" height="200" />
      <div>
        <h1>${product.get("name")}</h1>
        <p class="price">${product.get("price")}</p>
        <p class="description">${product.get("description")}</p>
        <p class="stock">Em stock: ${product.get("stock")}</p>
        <form class="add-to-cart" method="post" action="/cart/add">
          <input type="hidden" name=${csrfName} value=${csrfToken} />
          <input type="hidden" name="id" value=${product.get("id")} />
          <label>Quantidade
            <input type="number" name="quantity" value="1" min="1" max="20" />
          </label>
          <button type="submit">Adicionar ao carrinho</button>
        </form>
        <p><a href="/c/${product.get("categorySlug")}">Ver mais produtos desta categoria</a></p>
      </div>
    </article>
    <section class="reviews-section">
      <h2>Avaliações</h2>
      ReviewList(reviews = reviews)
      ReviewForm(productId = product.get("id"), csrfName = csrfName, csrfToken = csrfToken, form = form, errors = errors)
    </section>
  }
}
