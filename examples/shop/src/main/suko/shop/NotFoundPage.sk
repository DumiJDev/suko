package shop;

import shop.Layout;

public component NotFoundPage(String title, int cartCount, List<Map<String, String>> categories) {
  Layout(title = title, cartCount = cartCount, categories = categories) {
    <h1>Página não encontrada</h1>
    <p class="empty">O endereço pedido não existe nesta loja.</p>
    <p><a href="/">Voltar à página inicial</a></p>
  }
}
