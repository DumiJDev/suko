package com.example.ui;

import com.example.ui.layout.Layout as Layout;
import com.example.model.Item;

component Card<T>(String title, List<T> items, String emptyLabel = "Sem itens") {
  <div class="card">
    <h2>{title}</h2>
    if (items.size() > 0) {
      <ul>
        for (T item : items) {
          <li>{item.name} — {item.price?.format() ?: "sem preço"}</li>
        }
      </ul>
    } else {
      <p>{emptyLabel}</p>
    }
  </div>
}

component NavLink(String label, String href = "#") {
  <a href={href}>{label}</a>
}

component Page(User user) {
  Layout(title = "Dashboard") {
    Sidebar {
      NavLink(label = "Home", href = "/")
      NavLink(label = "Perfil")
    }
    Content {
      switch (user.role) {
        case "admin" -> { AdminPanel() }
        case "guest" -> { <p>Bem-vindo, visitante</p> }
        default -> { <p>Bem-vindo, {user.name}</p> }
      }
    }
  }
}
