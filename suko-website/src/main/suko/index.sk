component Index() {
  <div class="min-h-screen flex flex-col">
    <nav data-nav="home"></nav>

    <section class="bg-teal-500 text-ink-950 border-b-2 border-slate-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-12">
        <div data-pipeline="hello" class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-stretch">
          <figure class="panel flex flex-col">
            <figcaption class="flex justify-between gap-4 border-b-2 border-slate-900 px-4 py-2 font-mono text-xs"><span class="font-medium">greeting/Hello.sk</span><span class="text-slate-500">escreve</span></figcaption>
            <pre class="p-4 font-mono text-sm leading-relaxed text-slate-900 overflow-x-auto">package greeting;

component Hello(String name) &#123;
  &lt;p&gt;Olá, &#36;&#123;name&#125;!&lt;/p&gt;
&#125;</pre>
          </figure>

          <div class="flex flex-col lg:flex-row items-center justify-center gap-2 py-3 lg:py-0 lg:px-3" aria-hidden="true">
            <span class="w-4 h-4 bg-ink-950 border-2 border-ink-950"></span>
            <span class="rail w-1 h-6 lg:w-8 lg:h-1 bg-ink-950"></span>
            <span class="rail-label font-mono text-[11px] font-medium uppercase whitespace-nowrap">compila para</span>
            <span data-rail-last="true" class="rail rail-2 w-1 h-6 lg:w-8 lg:h-1 bg-ink-950"></span>
            <span class="station-arrive w-4 h-4 bg-ink-950 border-2 border-ink-950"></span>
          </div>

          <figure class="panel flex flex-col">
            <figcaption class="flex justify-between gap-4 border-b-2 border-slate-900 px-4 py-2 font-mono text-xs"><span class="font-medium">greeting/Hello.jte</span><span class="text-slate-500">o build gera</span></figcaption>
            <pre data-flap="true" class="p-4 font-mono text-sm leading-relaxed text-slate-900 overflow-x-auto">&#64;param String name

&lt;p&gt;Olá, &#36;&#123;name&#125;!&lt;/p&gt;</pre>
          </figure>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 mt-3">
          <p class="font-mono text-xs">Saída real do compilador, não uma ilustração.</p>
          <button type="button" data-replay="true" class="font-mono text-xs uppercase border-2 border-ink-950 px-3 py-1.5 hover:bg-ink-950 hover:text-teal-300">Recompilar</button>
        </div>

        <h1 class="font-display text-4xl md:text-5xl font-extrabold leading-[1.05] mt-10 mb-4 max-w-3xl">
          Componentes tipados em Java. Compilados para JTE puro.
        </h1>
        <p class="text-lg md:text-xl max-w-2xl mb-8">
          Escreve-se um <code>.sk</code>; o build gera um <code>.jte</code> normal. Sem motor de runtime próprio
          e sem dependência nova no seu Spring Boot.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="getting-started.html" class="px-5 py-3 font-mono text-sm uppercase bg-ink-950 text-white border-2 border-ink-950 hover:bg-white hover:text-ink-950">Começar</a>
          <a href="components/index.html" class="px-5 py-3 font-mono text-sm uppercase bg-white text-ink-950 border-2 border-ink-950 hover:bg-ink-950 hover:text-white">Ver componentes</a>
        </div>
      </div>
    </section>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-14">
      <nav aria-label="Secções" class="mb-20">
        <ol class="stopline">
          <li class="line-cli"><a href="getting-started.html" class="stop"><span class="stop-marker"></span><span class="stop-name">Getting Started</span><span class="stop-desc">Instalar a partir do código-fonte e compilar o primeiro componente.</span></a></li>
          <li class="line-core"><a href="language-reference.html" class="stop"><span class="stop-marker"></span><span class="stop-name">Language Reference</span><span class="stop-desc">Componentes, slots, lógica e as regras do compilador.</span></a></li>
          <li class="line-registry"><a href="components/index.html" class="stop"><span class="stop-marker"></span><span class="stop-name">Components</span><span class="stop-desc">8 componentes prontos a copiar para o seu projeto.</span></a></li>
          <li class="line-site"><a href="roadmap.html" class="stop"><span class="stop-marker"></span><span class="stop-name">Roadmap</span><span class="stop-desc">O que está feito e o que falta, incluindo o suporte de IDE.</span></a></li>
        </ol>
      </nav>

      <dl class="border-t-2 border-slate-900">
        <div class="grid md:grid-cols-[18rem_1fr] gap-2 md:gap-8 py-6 border-b-2 border-slate-900">
          <dt class="font-display text-xl font-extrabold">Nada do Suko em runtime</dt>
          <dd class="text-slate-700 max-w-2xl">1 componente Suko dá 1 template JTE, indistinguível de um escrito à mão. Um teste de integração serve estes templates com um Spring Boot real, por HTTP.</dd>
        </div>
        <div class="grid md:grid-cols-[18rem_1fr] gap-2 md:gap-8 py-6 border-b-2 border-slate-900">
          <dt class="font-display text-xl font-extrabold">O código é seu</dt>
          <dd class="text-slate-700 max-w-2xl"><code>suko add button</code> copia o <code>.sk</code> real para o seu projeto, ao estilo shadcn/ui. Não é uma dependência de biblioteca: altera-o à vontade.</dd>
        </div>
        <div class="grid md:grid-cols-[18rem_1fr] gap-2 md:gap-8 py-6 border-b-2 border-slate-900">
          <dt class="font-display text-xl font-extrabold">Pré-release, sem rodeios</dt>
          <dd class="text-slate-700 max-w-2xl">Ainda sem versão no Maven Central ou no Gradle Plugin Portal, sem extensão VSCode ou IntelliJ, e o Quarkus ainda não foi testado. O <a href="roadmap.html" class="text-link line-site">roadmap</a> mostra o que falta.</dd>
        </div>
      </dl>
    </main>

    <footer data-footer="true"></footer>
  </div>
}
