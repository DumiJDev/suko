package components;

component Index() {
  <div class="h-screen bg-gray-50">
    <nav class="bg-blue-600 text-white py-6">
      <div class="max-w-7xl mx-auto px-4">
        <h1 class="text-3xl font-bold">Suko</h1>
        <p class="text-blue-100 mt-2">Components</p>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-12">
      <h2 class="text-4xl font-bold text-gray-900 mb-8">Component Library</h2>

      <p class="text-xl text-gray-600 mb-8">
        Componentes reutilizáveis prontos para usar na sua aplicação.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Button</h3>
          <p class="text-gray-600">Botão com variantes de estilo (primary, secondary, ghost).</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Input</h3>
          <p class="text-gray-600">Campo de entrada de texto simples com placeholder.</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Label</h3>
          <p class="text-gray-600">Rótulo de texto simples para campos de formulário.</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Badge</h3>
          <p class="text-gray-600">Etiqueta compacta com variantes de cor.</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Alert</h3>
          <p class="text-gray-600">Caixa de aviso com variantes de cor e conteúdo livre.</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Card</h3>
          <p class="text-gray-600">Cartão com cabeçalho e rodapé opcionais, e conteúdo obrigatório.</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Field</h3>
          <p class="text-gray-600">Label e input emparelhados, compostos a partir de Label e Input.</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Dialog</h3>
          <p class="text-gray-600">Diálogo modal com Alpine.js para abrir/fechar.</p>
        </div>
      </div>
    </main>

    <footer class="border-t border-gray-200 bg-white py-8">
      <div class="max-w-7xl mx-auto px-4 text-center text-gray-500 text-sm">
        <p>© 2026 Suko. Documentação gerada com Suko.</p>
      </div>
