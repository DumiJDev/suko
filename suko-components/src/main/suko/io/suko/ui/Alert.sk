package io.suko.ui;

// Convenção 3: cada ramo do switch escreve a string de classe COMPLETA
// (mesmo padrão do Button e do Badge) — nunca "${...}" dentro de `class`.
//
// `children` (obrigatório, sem `= null`, tarefa 6/7): recolhe todo o
// conteúdo solto do bloco de chamada, incluindo conteúdo MISTO (texto
// solto intercalado com elementos HTML) — o caso de uso real dos
// children implícitos do subprojeto 6, que até agora só tinha sido
// exercitado com um único `Content` sintético em teste (nunca com
// conteúdo de verdade vindo de um bloco de chamada real).
public component Alert(String variant = "info", Component children) {
  switch (variant) {
    case "success" -> {
      <div class="rounded-md bg-green-50 p-4 text-sm text-green-700 ring-1 ring-inset ring-green-600/20">
        {children}
      </div>
    }
    case "warning" -> {
      <div class="rounded-md bg-yellow-50 p-4 text-sm text-yellow-800 ring-1 ring-inset ring-yellow-600/20">
        {children}
      </div>
    }
    case "danger" -> {
      <div class="rounded-md bg-red-50 p-4 text-sm text-red-700 ring-1 ring-inset ring-red-600/10">
        {children}
      </div>
    }
    default -> {
      <div class="rounded-md bg-blue-50 p-4 text-sm text-blue-700 ring-1 ring-inset ring-blue-600/20">
        {children}
      </div>
    }
  }
}
